<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV app: no touchscreen needed, runs on Android TV / Google TV -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />

    <!-- Ping utility, camera, Home Assistant -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Camera: checks the TV has an IP address before connecting, e.g. after standby -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Network status: whether Wi-Fi is on, its signal and speed -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Export and import between TVs: finding each other on Wi-Fi -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Export and import: Android 10 and older need this to reach folders and USB keys. Android 11+ doesn't use it. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- App tile menu: asks Android to show its uninstall confirmation -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Continue watching: reads what other apps publish to Android's Watch Next list -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <!-- Screensaver tab: changes how long the TV waits without input before its screensaver, once the
         user allows it in the TV's "Modify system settings" -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Android 11+ hides other apps unless we declare which ones we look up -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The home override looks up the stock home screens -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The Cameras dialog names the TV's screensaver when it isn't HomeBoard -->
        <intent>
            <action android:name="android.service.dreams.DreamService" />
        </intent>
        <!-- and opens the screen of the TV's Settings that chooses it; Google TV's Ambient mode says it's Google TV -->
        <package android:name="com.android.tv.settings" />
        <intent>
            <action android:name="android.settings.DREAM_SETTINGS" />
        </intent>
        <intent>
            <action android:name="com.google.android.tv.settings.ambient" />
        </intent>
        <!-- and the screen that allows it to change when the screensaver starts -->
        <intent>
            <action android:name="android.settings.action.MANAGE_WRITE_SETTINGS" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".HomeBoardApp"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- singleTask: Home and the home override bring back the one launcher instead of stacking copies -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A home app. The stock launcher has a higher priority, so it stays the default
                 (no chooser) unless it's disabled with ADB -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Optional home override (Launcher settings); the user must also enable it in Accessibility -->
        <service
            android:name=".HomeOverrideService"
            android:exported="true"
            android:label="@string/home_override_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_override_service" />
        </service>

        <!-- The screensaver: the cameras one after the other, once chosen in the TV's screensaver settings -->
        <service
            android:name=".CameraScreensaver"
            android:exported="true"
            android:label="@string/screensaver_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
